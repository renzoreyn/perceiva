generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Currency {
  USD
  GBP
  EUR
  CHF
  CNY
  IDR
  AMD
  RUB
  PHP
  SGD
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id               String    @id @default(cuid())
  supabaseId       String    @unique
  email            String    @unique
  name             String?
  avatarUrl        String?
  homeCurrency     Currency  @default(USD)
  onboardingDone   Boolean   @default(false)
  tutorialDone     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wallets          Wallet[]
  transactions     Transaction[]
  categories       Category[]
  budgets          Budget[]
  dashboardConfig  DashboardConfig?

  @@map("users")
}

model Wallet {
  id           String    @id @default(cuid())
  userId       String
  name         String
  baseCurrency Currency  @default(USD)
  cardColor    String    @default("card-space")
  cardStyle    String    @default("dark")
  emoji        String?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  icon      String          @default("circle")
  color     String          @default("#0A84FF")
  type      TransactionType
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

model Transaction {
  id                  String              @id @default(cuid())
  userId              String
  walletId            String
  categoryId          String?
  type                TransactionType
  amount              Float
  currency            Currency
  amountUsd           Float
  exchangeRateAtEntry Float
  note                String?
  date                DateTime            @default(now())
  isRecurring         Boolean             @default(false)
  recurrenceInterval  RecurrenceInterval?
  recurrenceEndDate   DateTime?
  parentId            String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([walletId])
  @@map("transactions")
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  period     String   @default("monthly")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@map("budgets")
}

model DashboardConfig {
  id      String @id @default(cuid())
  userId  String @unique
  widgets Json   @default("[]")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboard_configs")
}

model ExchangeRateCache {
  id        String   @id @default(cuid())
  base      Currency
  rates     Json
  fetchedAt DateTime @default(now())

  @@unique([base])
  @@map("exchange_rate_cache")
}
